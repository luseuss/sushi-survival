  entries:
  - trait: 1
    displayName: "\uC6A9\uAC10\uD568"
    victoryLine: "\uC815\uBA74\uC73C\uB85C \uB9DE\uC120 \uC6A9\uAE30\uAC00 \uC2B9\uB9AC\uB97C \uB9CC\uB4E4\uC5C8\uC5B4\uC694!"
    defeatLine: "\uC6A9\uAE30\uB294 \uCDA9\uBD84\uD588\uC5B4\uC694. \uB2E4\uC74C\uC5D4 \uD55C \uAC78\uC74C\uB9CC \uB354 \uC2E0\uC911\uD558\uAC8C."
  - trait: 2
    displayName: "\uC2E0\uC911\uD568"
    victoryLine: "\uB05D\uAE4C\uC9C0 \uCE68\uCC29\uD588\uB358 \uB2F9\uC2E0\uC774 \uC774\uACBC\uC2B5\uB2C8\uB2E4!"
    defeatLine: "\uC798 \uBC84\uD17C\uC5B4\uC694. \uB2E4\uC74C\uC5D4 \uAE30\uD68C\uB97C \uC870\uAE08 \uB354 \uACFC\uAC10\uD788 \uC7A1\uC544\uBD10\uC694."
  - trait: 3
    displayName: "\uB2E4\uC815\uD568"
    victoryLine: "\uACC1\uC758 \uBAA8\uB450\uB97C \uC9C0\uCF1C\uB0B8 \uB2F9\uC2E0, \uC815\uB9D0 \uBA4B\uC84C\uC5B4\uC694!"
    defeatLine: "\uADF8 \uB2E4\uC815\uD568\uC740 \uD5DB\uB418\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694. \uD55C \uBC88 \uB354 \uB3C4\uC804\uD574\uC694."
