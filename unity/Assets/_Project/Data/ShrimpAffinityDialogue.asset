%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d09f59162db04f43b3729a8f2130e37, type: 3}
  m_Name: ShrimpAffinityDialogue
  m_EditorClassIdentifier: 
  introLines:
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 0}
    text: "\uB09C \uC2A4\uC2DC\uC655\uAD6D \uCD5C\uACE0\uC758 \uB300\uC7A5\uC7A5\uC774
      \uAC00\uBB38\uC758 7\uB300 \uD6C4\uACC4\uC790, \uCE74\uB9C8\uB9AC\uC628\uC774\uB77C\uACE0
      \uD55C\uB2E4. \uC2A4\uC2DC\uC655\uAD6D\uC758 \uBAA8\uB4E0 \uBB34\uAE30\uB4E4\uC740
      \uB2E4 \uC6B0\uB9AC \uAC00\uBB38\uC774 \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uBCF4\uBA74
      \uB418\uC9C0, \uD6C4\uD6D7."
    background: {fileID: 0}
  - speakerName: "\uD50C\uB808\uC774\uC5B4"
    portrait: {fileID: 0}
    standing: {fileID: 0}
    text: "...\uB2F9\uC2E0\uC774 \uB4E4\uACE0 \uC788\uB294 \uAC83\uC740 \uBB34\uC5C7\uC774\uC8E0?"
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 0}
    text: "\uC774\uAC74 \uB098\uC758 \uBB34\uAE30 \uAC04\uC7A5 \uAD8C\uCD1D\uC774\uC9C0,
      \uC694\uBC88\uC5D0 \uB0B4\uAC00 \uBC1C\uBA85\uD55C \uC544\uC8FC \uAC15\uB825\uD55C
      \uBB34\uAE30\uC9C0. \uD558\uD558."
    background: {fileID: 0}
  - speakerName: "\uD50C\uB808\uC774\uC5B4"
    portrait: {fileID: 0}
    standing: {fileID: 0}
    text: "...\uBA4B\uC788\uB124\uC694."
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 0}
    text: "\uADF8\uB807\uAC8C \uC5B8\uC81C\uAE4C\uC9C0 \uAC81\uC7C1\uC774\uCC98\uB7FC
      \uC9C8\uBB38\uB9CC \uD558\uACE0 \uC788\uC744 \uAC70\uC9C0? \uC790, \uC120\uD0DD\uD574."
    background: {fileID: 0}
  question1:
    questionText: "\uC804\uC7A5\uC5D0 \uB098\uC11C\uAE30 \uC804\uC5D0 \uD655\uC778\uD55C\uB2E4.
      \uB124 \uBC29\uC2DD\uC740 \uBB50\uC9C0?"
    choices:
    - choiceText: "\uD55C \uBC29\uC5D0 \uB05D\uB0B8\uB2E4."
      augment: {fileID: 11400000, guid: bf6470ca0d7e6b94d88b6e4964f3f112, type: 2}
    - choiceText: "\uBA3C\uC800 \uBC84\uD2F0\uB294 \uCABD\uC774 \uC774\uAE34\uB2E4."
      augment: {fileID: 11400000, guid: 38c7d0896b5bf0841a10b1b5866d413f, type: 2}
    - choiceText: "\uB9DE\uAE30 \uC804\uC5D0 \uD53C\uD55C\uB2E4."
      augment: {fileID: 11400000, guid: 842843cb27d17c44c8354040618e72fe, type: 2}
  bossIntroLines:
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 0}
    text: "\uC9C0\uAE08 \uC774 \uC18C\uB9AC \uB4E4\uB9AC\uC9C0? \uCFE0\uCFF5\uCFE0\uCFF5
      \uCFE0\uCFF5."
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 0}
    text: "\uB4DC\uB514\uC5B4 \uB098\uC624\uB294\uAD70, \uC800 \uC790\uC2DD. \uB4DC\uB514\uC5B4
      \uB098\uC758 \uBB34\uAE30\uB85C \uC800 \uB140\uC11D\uC744 \uC5C6\uC560\uBC84\uB9B4
      \uC2DC\uAC04\uC774\uAD70. \uC800 \uB140\uC11D\uC740 \uC544\uAE4C \uB140\uC11D\uB4E4\uC774\uB791
      \uCC28\uC6D0\uC774 \uB2E4\uB974\uB2C8 \uC870\uC2EC\uD558\uB77C\uACE0!"
    background: {fileID: 0}
  bossEncounterLines:
  - speakerName: "\uB864\uBC95\uC0AC"
    portrait: {fileID: 21300000, guid: 4a12c5f85bd8f994a97dc974138a8098, type: 3}
    standing: {fileID: 0}
    text: "\uC2A4\uC2DC\uC655\uAD6D\uC758 \uBCD1\uC0AC\uAC00 \uC5EC\uAE30\uAE4C\uC9C0
      \uC624\uB2E4\uB2C8... \uB864\uC655\uAD6D\uC758 \uC774\uB984\uC73C\uB85C, \uC804\uBD80
      \uB3CC\uB3CC \uB9D0\uC544 \uC8FC\uB9C8!"
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
    text: "\uD765, \uC694\uB9AC\uC0AC \uC8FC\uC81C\uC5D0 \uC694\uB780\uD558\uAD70.
      \uB124 \uBC25\uC0C1\uC740 \uB0B4\uAC00 \uC5CE\uC5B4 \uC8FC\uC9C0."
    background: {fileID: 0}
  - speakerName: "\uB864\uBC95\uC0AC"
    portrait: {fileID: 21300000, guid: 4a12c5f85bd8f994a97dc974138a8098, type: 3}
    standing: {fileID: 0}
    text: "\uADF8 \uAC04\uC7A5 \uCD1D\uC73C\uB85C? \uB0B4 \uB864\uC740 \uCD1D\uC54C\uB85C
      \uB6AB\uB9AC\uC9C0 \uC54A\uB294\uB2E4!"
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
    text: "\uADF8\uB7FC \uB6AB\uB9B4 \uB54C\uAE4C\uC9C0 \uC3D8\uBA74 \uB418\uC9C0.
      \uC7A5\uC804 \uB05D\uB0AC\uC5B4!"
    background: {fileID: 0}
