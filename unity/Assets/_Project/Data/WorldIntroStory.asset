--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17b9cc5809743524aaa8653a282250ae, type: 3}
  m_Name: WorldIntroStory
  m_EditorClassIdentifier:
  lines:
  - speakerName: "\uc774\ub098\ub9ac"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uacf5\uc8fc\ub2d8 \ub864\uc655\uad6d\uc5d0\uc11c \uc5c4\uccad\ub09c \uc218\uc758 \uc801\uad70\uc774 \ubab0\ub824\uc624\uace0 \uc788\uc2b5\ub2c8\ub2e4"
    background: {fileID: 21300000, guid: 7d6d771bfc41ae14a9f9f61a592defbb, type: 3}
  - speakerName: "\uc544\ub378\ub9b0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: b100fb8bffdece446a6415dc441b02c9, type: 3}
    text: "....\uc5ed\uc2dc \uc18c\ubb38\ub300\ub85c\uad70\uc694"
    background: {fileID: 0}
  - speakerName: "\uce74\ub9c8\ub9ac\uc628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 34c8a59fb576e2943b03f20d9221f163, type: 3}
    text: "\ubcd1\ub825\uc758 \uaddc\ubaa8\ub294 \uc5bc\ub9c8\ub098 \ub418\uc9c0?"
    background: {fileID: 0}
  - speakerName: "\uc774\ub098\ub9ac"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uc815\ud655\ud55c \uc22b\uc790\ub294 \ubaa8\ub978\ub2e4 \ud558\uc9c0\ub9cc, \ub0b4\uac00 \ud30c\uc545\ud55c \ubc14\ub85c\ub294 \ub864\uc655\uad6d\uc758 \ucd1d\ubcd1\ub825\uc774 \ucd9c\ub3d9\ud588\ub2e4\uace0 \ud55c\ub2e4"
    background: {fileID: 0}
  - speakerName: "\uc544\ub378\ub9b0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: b100fb8bffdece446a6415dc441b02c9, type: 3}
    text: "\ub864\uc655\uad6d\uc774 \uc815\ub9d0 \uc791\uc815\uc744 \ud588\uad70\uc694"
    background: {fileID: 0}
  - speakerName: "\uce74\ub9c8\ub9ac\uc628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 34c8a59fb576e2943b03f20d9221f163, type: 3}
    text: "\uac71\uc815\ub9c8\uc2ed\uc2dc\uc624 \uacf5\uc8fc\ub2d8 \uc81c \uc190\uc5d0\uc11c \ub9cc\ub4e4\uc5b4\uc9c4 \ubb34\uae30\ub4e4\uc740 \uc5b4\ub5a4 \uc655\uad6d\ubcf4\ub2e4\ub3c4 \ub354 \ud6cc\ub96d\ud558\ub2c8\uae4c\uc694"
    background: {fileID: 0}
  - speakerName: "\uc544\ub378\ub9b0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: b100fb8bffdece446a6415dc441b02c9, type: 3}
    text: "\uadf8\ub7fc\uc694 \uc54c\uace0\uc788\uc2b5\ub2c8\ub2e4. \uce74\ub9c8\ub9ac\uc628\ub2d8\uc774 \ub9cc\ub4e4\uc5b4\uc900 \uc81c \ubb34\uae30\ub3c4 \ud6cc\ub96d\ud558\ub2c8\uae4c\uc694.. \ud558\uc9c0\ub9cc \uc800 \ub9ce\uc740 \ubcd1\ub825\uc744 \uc6b0\ub9ac\uac00 \uac10\ub2f9\ud560 \uc218 \uc788\uc744\uae4c \uac71\uc815\uc785\ub2c8\ub2e4"
    background: {fileID: 0}
  - speakerName: "\uc774\ub098\ub9ac"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uc6b0\ub9ac\ub294 \uc804\ud22c\ub97c \ud558\uba74 \ud560\uc218\ub85d \uac15\ud574\uc9c0\ub294 \ub2a5\ub825\uc774 \uc788\uc73c\ub2c8 \uac71\uc815\ub9c8\uc138\uc694"
    background: {fileID: 0}
  - speakerName: "\uce74\ub9c8\ub9ac\uc628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 34c8a59fb576e2943b03f20d9221f163, type: 3}
    text: "\uadf8\ub798\uc694 \uc800 \uc720\ubd80 \uace0\uc591\uc774 \ub9d0\uc774 \ub9de\uc2b5\ub2c8\ub2e4"
    background: {fileID: 0}
  - speakerName: "\uc774\ub098\ub9ac"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\ub09c \uc5ec\uc6b0\ub2e4!!!!!"
    background: {fileID: 0}
  - speakerName: "\uc544\ub378\ub9b0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: b100fb8bffdece446a6415dc441b02c9, type: 3}
    text: "\uc88b\uc2b5\ub2c8\ub2e4. \ub4e0\ub4e0\ud55c \uc9c0\uc6d0\uad70\uc774 \uc788\uc73c\ub2c8 \uc548\uc2ec\uc774 \ub418\ub294\uad70\uc694. \uc2a4\uc2dc\uc655\uad6d\uc744 \uc9c0\ud0a4\ub7ec \ub2e4\ud568\uaed8 \uc804\uc7a5\uc73c\ub85c \ud5a5\ud560 \ub54c\uac00 \ub418\uc5c8\uad70\uc694"
    background: {fileID: 0}
