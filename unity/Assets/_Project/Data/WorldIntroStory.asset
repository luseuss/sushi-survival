%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17b9cc5809743524aaa8653a282250ae, type: 3}
  m_Name: WorldIntroStory
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\uC774\uB098\uB9AC"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uACF5\uC8FC\uB2D8 \uC800\uC9DD\uC5D0 \uB864\uC655\uAD6D\uC5D0\uC11C \uC544\uB4E4\uC774
      \uB5BC\uAC70\uC9C0\uB85C \uC624\uACE0\uC788\uB2E4\uCE85\uB2C8\uB2E4"
    background: {fileID: 21300000, guid: 7d6d771bfc41ae14a9f9f61a592defbb, type: 3}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
    text: "....\uC5ED\uC2DC \uC18C\uBB38\uB300\uB85C\uAD70\uC694"
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
    text: "\uBCD1\uB825\uC758 \uADDC\uBAA8\uB294 \uC5BC\uB9C8\uB098 \uB418\uC9C0?"
    background: {fileID: 0}
  - speakerName: "\uC774\uB098\uB9AC"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uC815\uD655\uD55C \uC218\uB294 \uBAA8\uB974\uACA0\uB294\uB370, \uB0B4
      \uC54C\uAE30\uB85C\uB294 \uB864\uC655\uAD6D \uCD1D\uBCD1\uB825\uC774 \uC2F9
      \uB2E4 \uCD9C\uB3D9\uD588\uB2E4 \uCE74\uB354\uB77C"
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
    text: "\uB864\uC655\uAD6D\uC774 \uC815\uB9D0 \uC791\uC815\uC744 \uD588\uAD70\uC694"
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
    text: "\uAC71\uC815\uB9C8\uC2ED\uC2DC\uC624 \uACF5\uC8FC\uB2D8 \uC81C \uC190\uC5D0\uC11C
      \uB9CC\uB4E4\uC5B4\uC9C4 \uBB34\uAE30\uB4E4\uC740 \uC5B4\uB5A4 \uC655\uAD6D\uBCF4\uB2E4\uB3C4
      \uB354 \uD6CC\uB96D\uD558\uB2C8\uAE4C\uC694"
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
    text: "\uADF8\uB7FC\uC694 \uC54C\uACE0\uC788\uC2B5\uB2C8\uB2E4. \uCE74\uB9C8\uB9AC\uC628\uB2D8\uC774
      \uB9CC\uB4E4\uC5B4\uC900 \uC81C \uBB34\uAE30\uB3C4 \uD6CC\uB96D\uD558\uB2C8\uAE4C\uC694..
      \uD558\uC9C0\uB9CC \uC800 \uB9CE\uC740 \uBCD1\uB825\uC744 \uC6B0\uB9AC\uAC00
      \uAC10\uB2F9\uD560 \uC218 \uC788\uC744\uAE4C \uAC71\uC815\uC785\uB2C8\uB2E4"
    background: {fileID: 0}
  - speakerName: "\uC774\uB098\uB9AC"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uC544\uC774\uACE0 \uAC71\uC815\uB9C8\uC774\uC18C, \uC6B0\uB9AC\uAC00
      \uC2F8\uC6B8\uC218\uB85D \uB354 \uB3C5\uD574\uC9C4\uB2E4\uC544\uC785\uB2C8\uAE4C."
    background: {fileID: 0}
  - speakerName: "\uCE74\uB9C8\uB9AC\uC628"
    portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
    standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
    text: "\uADF8\uB798\uC694 \uC800 \uC720\uBD80 \uACE0\uC591\uC774 \uB9D0\uC774
      \uB9DE\uC2B5\uB2C8\uB2E4"
    background: {fileID: 0}
  - speakerName: "\uC774\uB098\uB9AC"
    portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
    standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
    text: "\uB0B4\uB294 \uC5EC\uC6B0\uB2E4. \uB610 \uACE0\uC591\uC774 \uC18C\uB9AC
      \uCE90\uC0AC\uBA74 \uACE0\uC591\uC774 \uBC25\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uBFD0\uB2E4."
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uB4E0\uB4E0\uD55C \uC9C0\uC6D0\uAD70\uC774
      \uC788\uC73C\uB2C8 \uC548\uC2EC\uC774 \uB418\uB294\uAD70\uC694. \uC2A4\uC2DC\uC655\uAD6D\uC744
      \uC9C0\uD0A4\uB7EC \uB2E4\uD568\uAED8 \uC804\uC7A5\uC73C\uB85C \uD5A5\uD560
      \uB54C\uAC00 \uB418\uC5C8\uAD70\uC694"
    background: {fileID: 0}
  choicePoints:
  - beforeLineIndex: 4
    prompt:
      speakerName: "\uC544\uB378\uB9B0"
      portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
      standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
      text: "\uCD1D\uBCD1\uB825\uC774 \uC804\uBD80 \uCD9C\uB3D9\uD588\uB2E4\uB2C8... \uB2F9\uC2E0\uC774\uB77C\uBA74 \uC774 \uC0C1\uD669\uC5D0\uC11C \uBB34\uC5C7\uC744 \uBA3C\uC800 \uD558\uACA0\uC5B4\uC694?"
      background: {fileID: 0}
    choices:
    - choiceText: "\uC815\uBA74\uC73C\uB85C \uB9DE\uC11C \uC2F8\uC6B4\uB2E4."
      trait: 1
      reply:
        speakerName: "\uCE74\uB9C8\uB9AC\uC628"
        portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
        standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
        text: "\uD558\uD558, \uBC30\uC9F1 \uC88B\uAD70! \uADF8\uB7F0 \uB140\uC11D\uC774 \uC788\uC5B4\uC57C \uC804\uC7A5\uC774 \uC0B4\uC9C0."
        background: {fileID: 0}
    - choiceText: "\uBA3C\uC800 \uC0C1\uD669\uBD80\uD130 \uC0B4\uD540\uB2E4."
      trait: 2
      reply:
        speakerName: "\uC774\uB098\uB9AC"
        portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
        standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
        text: "\uADF8\uB798 \uB9DE\uB2E4, \uC11C\uB450\uB974\uBA74 \uBC1C \uBE60\uC9C4\uB2E4 \uC544\uC774\uAC00. \uC798 \uBD24\uB2E4."
        background: {fileID: 0}
    - choiceText: "\uBC31\uC131\uB4E4\uBD80\uD130 \uC548\uC804\uD558\uAC8C \uD53C\uC2E0\uC2DC\uD0A8\uB2E4."
      trait: 3
      reply:
        speakerName: "\uC544\uB378\uB9B0"
        portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
        standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
        text: "...\uB530\uB73B\uD55C \uBD84\uC774\uC2DC\uAD70\uC694. \uC800\uB3C4 \uAC19\uC740 \uB9C8\uC74C\uC785\uB2C8\uB2E4."
        background: {fileID: 0}
  - beforeLineIndex: 8
    prompt:
      speakerName: "\uC774\uB098\uB9AC"
      portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
      standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
      text: "\uB2C8\uB294 \uC6B0\uC9E4\uB07C\uACE0? \uB2E4 \uAC19\uC774 \uC2F8\uC6B8 \uB54C, \uB2C8\uB294 \uBB58 \uC81C\uC77C \uBA3C\uC800 \uCC59\uAE38 \uAE30\uACE0?"
      background: {fileID: 0}
    choices:
    - choiceText: "\uC81C\uC77C \uC55E\uC5D0\uC11C \uAE38\uC744 \uC5F0\uB2E4."
      trait: 1
      reply:
        speakerName: "\uC774\uB098\uB9AC"
        portrait: {fileID: 21300000, guid: 3ad0cb01ba4f48229f03a84cfc5a6c6d, type: 3}
        standing: {fileID: 21300000, guid: 8938b1b9917c482493629b6f1a9048a8, type: 3}
        text: "\uC624\uC624, \uAC81\uB300\uAC00\uB9AC \uC5C6\uB294 \uAE30 \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4\uCE74\uC774!"
        background: {fileID: 0}
    - choiceText: "\uB4A4\uC5D0\uC11C \uC804\uCCB4 \uD750\uB984\uC744 \uC9C0\uCF1C\uBCF8\uB2E4."
      trait: 2
      reply:
        speakerName: "\uCE74\uB9C8\uB9AC\uC628"
        portrait: {fileID: 21300000, guid: 5b84c9f527aa4e6899d968b44a37c7a9, type: 3}
        standing: {fileID: 21300000, guid: 563fd5785a544cb4b74469a00d599e12, type: 3}
        text: "\uB4EC\uC9C1\uD558\uAD70. \uC804\uC7A5\uC5D4 \uADF8\uB7F0 \uB208\uC774 \uAF2D \uD544\uC694\uD558\uC9C0."
        background: {fileID: 0}
    - choiceText: "\uB2E4\uCE5C \uB3D9\uB8CC\uBD80\uD130 \uCC59\uAE34\uB2E4."
      trait: 3
      reply:
        speakerName: "\uC544\uB378\uB9B0"
        portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
        standing: {fileID: 21300000, guid: 2a1db57f751b4c14a607567bc9365eeb, type: 3}
        text: "\uADF8 \uB9C8\uC74C, \uC78A\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4 \uAC19\uC774 \uC0B4\uC544\uC11C \uB3CC\uC544\uC640\uC694."
        background: {fileID: 0}
