%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3d09f59162db04f43b3729a8f2130e37, type: 3}
  m_Name: EggAffinityDialogue
  m_EditorClassIdentifier: 
  introLines:
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uB9CC\uB098\uC11C \uBC18\uAC11\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uC2A4\uC2DC\uC655\uAD6D\uC758
      9\uBC88\uC9F8 \uC655\uB140, \uC544\uB378\uB9B0\uC774\uB77C\uACE0 \uD569\uB2C8\uB2E4."
    background: {fileID: 0}
  - speakerName: "\uD50C\uB808\uC774\uC5B4"
    portrait: {fileID: 0}
    text: "\uC9C0\uAE08 \uBB34\uC2A8 \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uB294\uAC70\uC8E0?"
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uC9C0\uAE08 \uB864\uC655\uAD6D\uC758 \uAD70\uB300\uAC00 \uC6B0\uB9AC
      \uC655\uAD6D\uC5D0 \uB4E4\uC774\uB2E5\uCE58\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    background: {fileID: 0}
  - speakerName: "\uD50C\uB808\uC774\uC5B4"
    portrait: {fileID: 0}
    text: "\uACF5\uC8FC\uB2D8\uC758 \uBB34\uAE30\uB294 \uBB34\uC5C7\uC774\uC8E0?"
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uC81C \uBB34\uAE30\uB294 \uACC4\uB780 \uC591\uC0B0\uC785\uB2C8\uB2E4."
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uC790, \uC774\uC81C \uC120\uD0DD\uD574\uC8FC\uC138\uC694."
    background: {fileID: 0}
  question1:
    questionText: "\uBAB0\uB824\uC624\uB294 \uC801\uB4E4 \uC55E\uC5D0\uC11C, \uB10C
      \uC5B4\uB5BB\uAC8C \uC2F8\uC6B8 \uAC70\uC57C?"
    choices:
    - choiceText: "\uC81C \uC591\uC0B0\uC774 \uB2FF\uB294 \uACF3\uC740 \uC804\uBD80
        \uC4F8\uC5B4\uBC84\uB9AC\uACA0\uC5B4\uC694."
      augment: {fileID: 11400000, guid: bf6470ca0d7e6b94d88b6e4964f3f112, type: 2}
    - choiceText: "\uBB34\uB108\uC9C0\uC9C0 \uC54A\uB294 \uAC8C \uBA3C\uC800\uC608\uC694.
        \uBC84\uD2F8 \uC218 \uC788\uC5B4\uC57C \uC774\uAE38 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
      augment: {fileID: 11400000, guid: 38c7d0896b5bf0841a10b1b5866d413f, type: 2}
    - choiceText: "\uBC1C\uC774 \uBE60\uB974\uBA74, \uC560\uCD08\uC5D0 \uB2E4\uCE60
        \uC77C\uC774 \uC5C6\uC8E0."
      augment: {fileID: 11400000, guid: 842843cb27d17c44c8354040618e72fe, type: 2}
  bossIntroLines:
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uC9C0\uAE08 \uC774 \uC18C\uB9AC \uB4E4\uB9AC\uC2DC\uB098\uC694? \uCFE0\uCFF5!!
      \uCFE0\uCFF5!! \uCFE0\uCFF5!!"
    background: {fileID: 0}
  - speakerName: "\uC544\uB378\uB9B0"
    portrait: {fileID: 21300000, guid: 9d869ea5b7b241978f2a32f14ee0556b, type: 3}
    text: "\uC800 \uC874\uC7AC\uB294 \uB864\uC655\uAD6D\uC774 \uAE38\uB7EC\uC628
      \uC804\uD22C \uBCD1\uAE30\uC785\uB2C8\uB2E4. \uC9C0\uAE08\uAE4C\uC9C0 \uB9C8\uC8FC\uD588\uB358
      \uC801\uB4E4\uACFC \uCC28\uC6D0\uC774 \uB2E4\uB974\uB2C8 \uC870\uC2EC\uD558\uC154\uC57C
      \uD569\uB2C8\uB2E4."
    background: {fileID: 0}
